{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Wind Waker (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-msvc-relwithdebinfo/dusklight.exe",
            "args": ["--develop", "--trace", "--dvd", "C:/Users/brian/Dev/tww/orig/GZLE01/game.iso"],
            "cwd": "${workspaceFolder}/build/windows-msvc-relwithdebinfo",
            "console": "integratedTerminal"
        },
        {
            "name": "(gdb) Launch Dusklight MSVC",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-l", "1", "--dvd", "${workspaceRoot}/orig/GZ2E01/GZ2E01.iso", "--console"],
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "symbolSearchPath": "${command:cmake.launchTargetPath}",
            "console": "integratedTerminal",
            "cwd":"${workspaceRoot}"
        }
    ]
}
